  },
  {
    "id": 11,
    "postId": 14,
    "user": "202300004",
    "text": "A mí me funciona estudiar en grupo.",
    "date": "2026-09-29T23:11:01.534Z"
  },
  {
    "id": 12,
    "postId": 9,
    "user": "202300002",
    "text": "¡Te quedó increíble!",
    "date": "2026-09-29T23:11:01.542Z"
  },
  {
    "id": 13,
    "postId": 12,
    "user": "202300003",
    "text": "Repórtenlo a la facultad, así lo arreglan más rápido.",
