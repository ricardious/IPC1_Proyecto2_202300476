  },
  {
    "id": 4,
    "postId": 10,
    "user": "202300476",
    "text": "Yo me apunto, escríbeme.",
    "date": "2026-09-29T23:11:01.491Z"
  },
  {
    "id": 5,
    "postId": 10,
    "user": "202300003",
    "text": "¿De qué sección eres?",
    "date": "2026-09-29T23:11:01.497Z"
  },
  {
    "id": 6,
    "postId": 10,
    "user": "202300001",
    "text": "Sección B, ¿y tú?",
    "date": "2026-09-29T23:11:01.505Z"
  },
  {
    "id": 7,
    "postId": 11,
    "user": "202300002",
    "text": "Tengo unos, te los paso.",
    "date": "2026-09-29T23:11:01.512Z"
  },
  {
    "id": 8,
    "postId": 11,
    "user": "202300476",
    "text": "Buenas, yo también los necesito.",
    "date": "2026-09-29T23:11:01.518Z"
  },
  {
    "id": 9,
    "postId": 8,
    "user": "202300005",
    "text": "¿Cuándo cierra la convocatoria?",
    "date": "2026-09-29T23:11:01.523Z"
  },
  {
    "id": 10,
    "postId": 13,
    "user": "202300001",
    "text": "Tengo que ir entonces.",
